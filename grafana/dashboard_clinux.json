        "w": 8,
        "h": 4
      },
      "description": "Facturación neta de comprobantes asociados a clientes identificados, incluyendo devoluciones.",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_CLINUX}"
      },
      "targets": [
