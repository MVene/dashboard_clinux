      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Crecimiento vs. período anterior",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "description": "Crecimiento de facturación neta contra el intervalo inmediatamente anterior de igual cantidad de días. No equivale necesariamente a crecimiento real por inflación.",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_CLINUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_CLINUX}"
          },
          "rawSql": "\nWITH limites AS (\n    SELECT ($__timeFrom())::date AS desde,\n           ($__timeTo())::date AS hasta\n), totales AS (\n    SELECT\n        SUM(d.ventas) FILTER (\n            WHERE d.dia BETWEEN l.desde AND l.hasta\n        ) AS actual,\n        SUM(d.ventas) FILTER (\n            WHERE d.dia >= l.desde - (l.hasta - l.desde + 1)\n              AND d.dia < l.desde\n        ) AS anterior\n    FROM clinux_ventas_diarias d CROSS JOIN limites l\n)\nSELECT CASE WHEN anterior > 0\n       THEN ROUND((actual - anterior) * 100.0 / anterior, 1)\n       ELSE NULL END AS \"Crecimiento (%)\"\nFROM totales\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#70C788"
          },
          "unit": "percent",
          "custom": {},
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
