    {
      "id": 9,
      "title": "Detalle de clientes mayoristas",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 11
      },
      "description": "Hasta 20 clientes por monto comprado neto en el período. Datos comerciales sensibles: compartir solo con usuarios autorizados.",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_CLINUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_CLINUX}"
          },
          "rawSql": "\nSELECT nombre_cliente AS \"Cliente mayorista\",\n       SUM(comprobantes)::bigint AS \"Tickets\",\n       ROUND(SUM(ventas)::numeric, 2) AS \"Compras netas (ARS)\",\n       MAX(dia) AS \"Última compra\"\nFROM clinux_clientes_diarios\nWHERE mayorista = TRUE\n  AND $__timeFilter(dia::timestamp)\nGROUP BY cliente, nombre_cliente\nORDER BY \"Compras netas (ARS)\" DESC\nLIMIT 20\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#28B9B3"
          },
          "unit": "none",
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Compras netas (ARS)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currency:financial:$"
