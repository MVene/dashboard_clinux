    {
      "id": 3,
      "title": "Tickets totales · período",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Cuenta facturas y tickets; no agrega notas de crédito como tickets nuevos.",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_CLINUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_CLINUX}"
          },
          "rawSql": "SELECT COALESCE(SUM(comprobantes), 0) AS \"Tickets\" FROM clinux_ventas_diarias WHERE $__timeFilter(dia::timestamp)",
