    {
      "id": 7,
      "title": "Crecimiento y rendimiento · evolución mensual",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "description": "Ventas y ganancia registrada por mes, sumando únicamente los días incluidos en el período seleccionado. Los meses extremos pueden ser parciales.",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_CLINUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_CLINUX}"
          },
          "rawSql": "\nSELECT date_trunc('month', dia::timestamp) AS time,\n       SUM(ventas)::double precision AS \"Ventas\",\n       SUM(ganancia_registrada)::double precision AS \"Ganancia registrada\"\nFROM clinux_ventas_diarias\nWHERE $__timeFilter(dia::timestamp)\nGROUP BY 1 ORDER BY 1\n",
          "format": "time_series",
          "editorMode": "code"
