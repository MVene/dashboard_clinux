      "description": "Ranking por cantidad de unidades netas vendidas durante el período; las devoluciones restan.",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_CLINUX}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_CLINUX}"
          },
          "rawSql": "\nSELECT producto AS \"Producto\",\n       ROUND(SUM(unidades)::numeric, 1) AS \"Unidades\"\nFROM clinux_productos_diarios\nWHERE $__timeFilter(dia::timestamp)\nGROUP BY item, producto\nHAVING SUM(unidades) > 0\nORDER BY \"Unidades\" DESC\nLIMIT 10\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
