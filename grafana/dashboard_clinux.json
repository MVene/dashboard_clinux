          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_CLINUX}"
          },
          "rawSql": "\nSELECT COALESCE(SUM(ventas), 0) AS \"Total\"\nFROM clinux_clientes_diarios\nWHERE mayorista = TRUE\n  AND $__timeFilter(dia::timestamp)\n",
